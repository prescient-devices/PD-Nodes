  "license": "MIT",
  "node-red": {
    "version": ">=2.1.3",
    "nodes": {
      "downloadfile": "downloadfile.js"
    }
  },
  "keywords": [
    "node-red",
    "download",
    "file",
    "stream"
  ],
  "bugs": {
    "url": "https://github.com/prescient-devices/PD-Nodes/issues"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "devDependencies": {
    "chai": "^4.3.10",
    "clone": "^2.1.2",
    "express": "^4.22.3",
    "jshint": "^2.13.6",
    "mocha": "^10.2.0",
    "node-netstat": "^1.8.0",
    "node-red": "^3.1.0",
    "node-red-node-test-helper": "^0.3.2",
    "prettier": "^3.0.3",
    "puppeteer": "^21.3.8",
    "sinon": "^9.2.4"
  }
}
